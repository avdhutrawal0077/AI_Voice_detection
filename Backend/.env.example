# Application Configuration
APP_NAME=Voice Integrity Verification API
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=voice_detection

# Audio Ingestion & Buffer
SAMPLE_RATE=16000
WINDOW_DURATION_SEC=1.0
HOP_DURATION_SEC=0.5
SESSION_TIMEOUT_SEC=60.0
MAX_PCM_SIZE_ELEMENTS=160000

# AI Pipeline Configuration
AI_PIPELINE_DIR=../AI_Pipeline
INFERENCE_WINDOW_SEC=2.0
USE_REAL_PIPELINE=true
